#!/usr/bin/env bash

function ensurePackage() {
    local commandName="$1"
    local packageName="${2:-$commandName}"

    if ! command -v "$commandName" &> /dev/null; then
        echo "Installing $packageName"
        sudo apt-get install "$packageName" -y
    fi
}

function updateDotfiles() {
    currentDir=$(pwd)
    cd $HOME/.dotfiles
    git fetch origin main
    git checkout main
    git reset --hard origin/main
    ./installscript
    cd $currentDir
    reloadcli
}

function ips() {
    ensurePackage dns dnsutils

    nameservers=(8.8.8.8 8.8.4.4 1.1.1.1 195.129.12.122 192.76.144.66 158.43.240.3 77.88.8.8)
    type=${2:-A}
    for i in "${nameservers[@]}";
    do
        echo "$i"
        dig @"$i" +nocmd "$1" $type +multiline +noall +answer
        echo
    done
}

function wholisten() {
    ensurePackage netstat net-tools

    sudo netstat -ltnp | grep ":$1"
}

function ports() {
    ensurePackage netstat net-tools

    sudo netstat -ltnp
}


# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$@"
}

# All the dig info
function digga() {
    ensurePackage dig dnsutils

    type=${2:-A}
    dig +nocmd "$1" "$type" +multiline +noall +answer
}

function archive() {
    ensurePackage zip

    zip -r "$1".zip "$1" ;
}

function removehost() {
    ssh-keygen -R "$1"
}

function scanhost() {
    ssh-keyscan -H "$1" >> ~/.ssh/known_hosts
}

#  Commit everything
function commit() {
    commitMessage="$1"

    if [ "$commitMessage" = "" ]; then
        commitMessage="wip"
    fi

    git add .
    eval "git commit -a -m '${commitMessage}'"
}

# push to remote origin
function push() {
    target=${1:-origin}
    branch=$(git branch | awk '/\*/ { print $2; }')
    git push $target $branch
}

# force push current branch to remote origin
function pushforce() {
    branch=$(git branch | awk '/\*/ { print $2; }')
    git push origin +$branch
}

function phpversion() {
    version=$(php --version | head -n 1 | cut -d " " -f 2 | cut -d "." -f 1,2)
    echo $version
}

function scheduler() {
    while :; do
        php artisan schedule:run
        echo "Sleeping 60 seconds..."
        sleep 60
    done
}

function phpini() {
    iniPath=$(php -i | grep /.+/php.ini -oE)
    vim $iniPath
}

function scanNetwork() {
    ensurePackage nmap

    local defaultNet="192.168.1.0/24"
    local network="${1:-$defaultNet}"
    echo "scanning network $network"
    nmap -sn $network -oG - | awk '/Up$/{print $2 " " $3}'
}

function watchlog() {
    tail -f -n 50 storage/logs/laravel.log
}

function silent() {
   "$@" >& /dev/null
}

function watchfolder() {
    ensurePackage fswatch

    folder=${1:-$(pwd)}
    echo "start watching $folder"
    fswatch --recursive --event-flags --event-flag-separator=" | " --timestamp --format-time="%Y-%m-%d %H:%M:%S %Z: " $folder
}

function fixHostnameForITerm() {
    # fix hostname for iTerm
    # https://gitlab.com/gnachman/iterm2/-/wikis/scp-not-connecting#how-can-i-override-the-hostname
    local detected_host iterm2_host custom_host exports_file
    detected_host=$(hostname -f)
    if [[ $detected_host == *.localdomain ]]; then
        detected_host=${detected_host%.localdomain}
    fi

    echo "iTerm hostname (from this machine): $detected_host"
    read -r -p "Use this for upload/download (scp) targets? [Y/n]: " use_detected
    iterm2_host=$detected_host
    if [[ $use_detected =~ ^[Nn]$ ]]; then
        read -r -p "Enter FQDN (e.g. server.example.com): " custom_host
        custom_host="${custom_host#"${custom_host%%[![:space:]]*}"}"
        custom_host="${custom_host%"${custom_host##*[![:space:]]}"}"
        if [ -n "$custom_host" ]; then
            iterm2_host=$custom_host
        else
            echo "Empty input; keeping detected hostname: $detected_host"
        fi
    fi

    exports_file=$HOME/.dotfiles-custom/shell/.exports
    if [ ! -f "$exports_file" ]; then
        mkdir -p "$HOME/.dotfiles-custom/shell"
        touch "$exports_file"
    fi

    if [ -s "$exports_file" ]; then
        grep -v '^export iterm2_hostname=' "$exports_file" > "${exports_file}.tmp" && mv "${exports_file}.tmp" "$exports_file"
    fi

    echo "export iterm2_hostname=$iterm2_host" >> "$exports_file"

    reloadcli
}



